# Redis
REDIS_URL=redis://localhost:6379

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Arize Phoenix
ARIZE_SPACE_KEY=
ARIZE_API_KEY=

# Cartesia (NPC voices: speech-to-text and text-to-speech); empty = the browser's own voice
CARTESIA_API_KEY=

# CRS sandbox (Gus's identity check, ml/online/crs.py); empty = offline mirror. Keep the quotes.
CRS_USERNAME=""
CRS_PASSWORD=""

# Sentry
SENTRY_DSN=

# Feature flags
USE_STUBS=true
RETRAIN_THRESHOLD=5
